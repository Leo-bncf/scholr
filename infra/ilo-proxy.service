[Unit]
Description=iLO relay for the Scholr platform console (verifies against the infrastructure CA)
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/caddy run --config /etc/scholr/ilo-proxy.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
