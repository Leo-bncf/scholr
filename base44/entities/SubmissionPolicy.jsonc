{
  "name": "SubmissionPolicy",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "One policy record per school"
    },
    "allowed_formats": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "file_upload",
          "link",
          "google_doc",
          "google_slides",
          "google_sheet"
        ]
      },
      "default": [
        "file_upload",
        "link",
        "google_doc",
        "google_slides",
        "google_sheet"
      ]
    },
    "default_primary_format": {
      "type": "string",
      "enum": [
        "file_upload",
        "link",
        "google_doc",
        "google_slides",
        "google_sheet"
      ]
    },
    "allow_teacher_format_override": {
      "type": "boolean",
      "default": true
    },
    "late_submission_default": {
      "type": "string",
      "enum": [
        "allowed",
        "blocked",
        "penalised"
      ],
      "default": "allowed"
    },
    "late_penalty_percent": {
      "type": "number",
      "default": 0
    },
    "late_window_hours": {
      "type": "number",
      "default": 0
    },
    "allow_teacher_late_override": {
      "type": "boolean",
      "default": true
    },
    "allowed_file_extensions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "max_file_size_mb": {
      "type": "number",
      "default": 50
    },
    "max_files_per_submission": {
      "type": "number",
      "default": 10
    },
    "retention_days_submissions": {
      "type": "number",
      "default": 1825
    },
    "retention_days_attachments": {
      "type": "number",
      "default": 1825
    },
    "plagiarism_flag_enabled": {
      "type": "boolean",
      "default": false
    },
    "resubmission_limit": {
      "type": "number",
      "default": 0
    },
    "show_submission_history_to_student": {
      "type": "boolean",
      "default": true
    },
    "show_submission_history_to_teacher": {
      "type": "boolean",
      "default": true
    },
    "require_submission_acknowledgement": {
      "type": "boolean",
      "default": false
    },
    "acknowledgement_text": {
      "type": "string"
    }
  },
  "required": [
    "school_id"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    }
  }
}