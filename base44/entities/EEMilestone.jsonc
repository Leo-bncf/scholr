{
  "name": "EEMilestone",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "supervisor_id": {
      "type": "string"
    },
    "supervisor_name": {
      "type": "string"
    },
    "subject_area": {
      "type": "string",
      "description": "EE subject area"
    },
    "research_question": {
      "type": "string"
    },
    "milestone_type": {
      "type": "string",
      "enum": [
        "initial_proposal",
        "first_meeting",
        "research_planning",
        "first_draft",
        "interim_reflection",
        "second_draft",
        "final_draft",
        "viva_voce"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "submission_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "submitted",
        "reviewed",
        "approved",
        "needs_revision"
      ],
      "default": "pending"
    },
    "draft_url": {
      "type": "string",
      "description": "Link to draft document"
    },
    "student_notes": {
      "type": "string"
    },
    "supervisor_feedback": {
      "type": "string"
    },
    "supervisor_feedback_date": {
      "type": "string",
      "format": "date-time"
    },
    "word_count": {
      "type": "number"
    },
    "meeting_notes": {
      "type": "string",
      "description": "Notes from supervision meetings"
    }
  },
  "required": [
    "school_id",
    "student_id",
    "milestone_type"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}",
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.supervisor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "school_admin",
                "ib_coordinator"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "$or": [
        {
          "data.supervisor_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "school_admin",
                "ib_coordinator"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    }
  }
}