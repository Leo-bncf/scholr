{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "Null for platform-level actions"
    },
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "e.g. user_created, class_created, role_changed, school_suspended"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "create": {},
    "read": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "update": {},
    "delete": {}
  }
}