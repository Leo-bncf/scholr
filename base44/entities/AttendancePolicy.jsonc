{
  "name": "AttendancePolicy",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "One record per school"
    },
    "codes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "counts_as_absent": {
            "type": "boolean",
            "default": false
          },
          "requires_note": {
            "type": "boolean",
            "default": false
          },
          "is_default": {
            "type": "boolean",
            "default": false
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "id",
          "key",
          "label"
        ]
      },
      "default": []
    },
    "reason_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "default": []
    },
    "require_reason_for_absence": {
      "type": "boolean",
      "default": false
    },
    "require_correction_reason": {
      "type": "boolean",
      "default": true
    },
    "chronic_absence_threshold_percent": {
      "type": "number",
      "default": 20
    },
    "frequent_lateness_threshold": {
      "type": "number",
      "default": 3
    }
  },
  "required": [
    "school_id"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    }
  }
}