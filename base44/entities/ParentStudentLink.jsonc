{
  "name": "ParentStudentLink",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "parent_id": {
      "type": "string"
    },
    "parent_name": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "relationship": {
      "type": "string",
      "enum": [
        "mother",
        "father",
        "guardian",
        "other"
      ],
      "default": "guardian"
    }
  },
  "required": [
    "school_id",
    "parent_id",
    "student_id"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}",
      "$or": [
        {
          "data.parent_id": "{{user.id}}"
        },
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "school_admin",
                "ib_coordinator",
                "teacher"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    }
  }
}