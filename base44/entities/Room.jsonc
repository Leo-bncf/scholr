{
  "name": "Room",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "building": {
      "type": "string"
    },
    "capacity": {
      "type": "number"
    },
    "room_type": {
      "type": "string",
      "enum": [
        "classroom",
        "lab",
        "gym",
        "library",
        "auditorium",
        "office",
        "other"
      ],
      "default": "classroom"
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "unavailable"
      ],
      "default": "active"
    },
    "external_sync_id": {
      "type": "string"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "school_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    }
  }
}