{
  "name": "GradebookPolicy",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string",
      "description": "One record per school"
    },
    "grading_model": {
      "type": "string",
      "enum": [
        "points_based",
        "category_weights",
        "ib_criteria_only"
      ],
      "default": "points_based"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "weight_percent": {
            "type": "number"
          },
          "color": {
            "type": "string"
          },
          "drop_lowest": {
            "type": "number",
            "default": 0
          },
          "applies_to_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "default": []
    },
    "allow_teacher_category_override": {
      "type": "boolean",
      "default": true
    },
    "default_visible_to_student": {
      "type": "boolean",
      "default": false
    },
    "default_visible_to_parent": {
      "type": "boolean",
      "default": false
    },
    "feedback_only_mode": {
      "type": "boolean",
      "default": false
    },
    "grade_release_mode": {
      "type": "string",
      "enum": [
        "immediate",
        "teacher_controlled",
        "scheduled",
        "coordinator_release"
      ],
      "default": "teacher_controlled"
    },
    "scheduled_release_date": {
      "type": "string",
      "format": "date-time"
    },
    "allow_teacher_visibility_override": {
      "type": "boolean",
      "default": true
    },
    "reporting_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "opens_at": {
            "type": "string",
            "format": "date-time"
          },
          "locks_at": {
            "type": "string",
            "format": "date-time"
          },
          "term_id": {
            "type": "string"
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "default": []
    },
    "lock_grades_after_deadline": {
      "type": "boolean",
      "default": false
    },
    "require_justification_for_locked_edit": {
      "type": "boolean",
      "default": false
    },
    "justification_min_chars": {
      "type": "number",
      "default": 20
    },
    "admin_can_override_lock": {
      "type": "boolean",
      "default": true
    },
    "predicted_grades_enabled": {
      "type": "boolean",
      "default": true
    },
    "predicted_grade_entry_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "teacher",
          "ib_coordinator",
          "school_admin"
        ]
      },
      "default": [
        "teacher",
        "ib_coordinator"
      ]
    },
    "predicted_grades_require_rationale": {
      "type": "boolean",
      "default": true
    },
    "coordinator_can_lock_predicted": {
      "type": "boolean",
      "default": true
    },
    "predicted_grades_locked": {
      "type": "boolean",
      "default": false
    },
    "predicted_grades_released_to_student": {
      "type": "boolean",
      "default": false
    },
    "predicted_grades_released_to_parent": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "school_id"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}"
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    }
  }
}