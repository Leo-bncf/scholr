{
  "name": "AttendanceRecord",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "class_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "excused"
      ],
      "default": "present"
    },
    "note": {
      "type": "string"
    },
    "reason_category": {
      "type": "string",
      "description": "Reason category ID from AttendancePolicy"
    },
    "recorded_by": {
      "type": "string"
    },
    "correction_history": {
      "type": "array",
      "description": "Audit trail of corrections made to this record",
      "items": {
        "type": "object",
        "properties": {
          "corrected_at": {
            "type": "string",
            "format": "date-time"
          },
          "corrected_by": {
            "type": "string"
          },
          "corrected_by_name": {
            "type": "string"
          },
          "previous_status": {
            "type": "string"
          },
          "new_status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "last_corrected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_corrected_by": {
      "type": "string"
    }
  },
  "required": [
    "school_id",
    "class_id",
    "student_id",
    "date",
    "status"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "teacher",
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}",
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "teacher",
                "school_admin",
                "ib_coordinator"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    }
  }
}