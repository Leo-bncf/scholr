{
  "name": "TOKTask",
  "type": "object",
  "properties": {
    "school_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string",
      "description": "If null, task is class-wide"
    },
    "student_name": {
      "type": "string"
    },
    "teacher_id": {
      "type": "string"
    },
    "teacher_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "exhibition_planning",
        "exhibition_draft",
        "exhibition_final",
        "essay_planning",
        "essay_draft",
        "essay_final",
        "presentation",
        "reflection",
        "reading",
        "other"
      ]
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "submission_date": {
      "type": "string",
      "format": "date-time"
    },
    "submission_url": {
      "type": "string"
    },
    "submission_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "submitted",
        "reviewed",
        "graded"
      ],
      "default": "pending"
    },
    "teacher_feedback": {
      "type": "string"
    },
    "teacher_feedback_date": {
      "type": "string",
      "format": "date-time"
    },
    "grade": {
      "type": "string",
      "description": "TOK grade if applicable"
    },
    "is_class_wide": {
      "type": "boolean",
      "default": false,
      "description": "If true, task applies to all DP students"
    }
  },
  "required": [
    "school_id",
    "title",
    "task_type"
  ],
  "rls": {
    "create": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "teacher",
            "school_admin",
            "ib_coordinator"
          ]
        }
      }
    },
    "read": {
      "data.school_id": "{{user.data.school_id}}",
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "school_admin",
                "ib_coordinator"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "data.school_id": "{{user.data.school_id}}",
      "$or": [
        {
          "data.teacher_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "school_admin",
                "ib_coordinator"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "data.school_id": "{{user.data.school_id}}",
      "user_condition": {
        "role": "school_admin"
      }
    }
  }
}