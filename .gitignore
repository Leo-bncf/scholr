.env
base44/.app.jsonc

# Cached base44 app definition pulled by scripts/base44-pull.mjs.
# Full app config including auth settings — never commit.
scripts/.cache/

# Graphify knowledge graph — generated, rebuild with `graphify update .`
graphify-out/

# Hallmark project memory — committed on purpose: the next design run reads it
# to avoid repeating a macrostructure. Nothing secret in it.

# Local credentials written by the seed and super-admin scripts. Never committed.
.local/

# Written by scripts/gen-sitemap.mjs on every build so the deploy can tell
# which commit is live. Generated, therefore not tracked — a committed copy
# would leave the tree dirty after every build and trip the deploy's own
# dirty-checkout guard.
public/build-info.json
